# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Number of reverse-proxy hops to trust (0 locally, 1 behind a single load balancer)
TRUST_PROXY=0
JSON_BODY_LIMIT=1mb

# ─── CORS / Frontend ───────────────────────────────────────
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Used to build links in emails (verify email, reset password)
FRONTEND_URL=http://localhost:5173

# ─── Rate limiting (applies to /api/v1, excluding health checks) ─
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# memory (single instance) | redis (shared across instances — use in production)
RATE_LIMIT_STORE=memory

# ─── MongoDB ───────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/flowpost

# ─── Redis (cache, rate limiting, BullMQ) ───────────────────
REDIS_URL=redis://localhost:6379

# ─── Authentication ────────────────────────────────────────
# REQUIRED. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=flowpost-api
JWT_AUDIENCE=flowpost-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Seconds a just-rotated refresh token is still accepted (reload during refresh, parallel tabs). 0 = off
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
WORKSPACE_INVITATION_TTL_DAYS=7
# Leave empty for host-only cookies. Set (e.g. .flowpost.app) if API and app are on sibling subdomains.
COOKIE_DOMAIN=
# lax (same-site app + API) | strict | none (cross-site; requires NODE_ENV=production)
COOKIE_SAME_SITE=lax

# ─── Email ─────────────────────────────────────────────────
# console (log emails, dev) | memory (tests) | smtp (required in production)
EMAIL_PROVIDER=console
EMAIL_FROM="FlowPost <no-reply@flowpost.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── File storage (Oracle Cloud Object Storage, as in jobs-viewer) ─
# none (uploads disabled) | memory (tests only) | oci
STORAGE_PROVIDER=none
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
# e.g. ap-singapore-1
OCI_REGION=
OCI_NAMESPACE=
OCI_BUCKET=
# Provide the API signing key ONE way — never commit it:
#   OCI_PRIVATE_KEY_PATH=./secrets/oci_api_key.pem   (secrets/ and *.pem are gitignored)
#   OCI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
OCI_PRIVATE_KEY_PATH=
OCI_PRIVATE_KEY=
OCI_PRIVATE_KEY_PASSPHRASE=
# Optional: serve files from a CDN or custom domain instead of the bucket URL
STORAGE_PUBLIC_BASE_URL=
UPLOAD_MAX_FILE_SIZE_MB=10
# Videos can be larger; uploads stream through temporary files on disk, not memory
UPLOAD_MAX_VIDEO_SIZE_MB=100
UPLOAD_MAX_FILES=10

# ─── AI ────────────────────────────────────────────────────
# `openai` (default) or `none` to disable AI features.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Defaults to gpt-5.6-terra. Add new models to src/integrations/ai/pricing.ts for cost estimates.
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Per attempt. Timeouts, 429s and 5xx responses are retried with exponential backoff.
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
# Upper bound per request (a full content strategy needs about 12,000).
AI_MAX_OUTPUT_TOKENS=16000

# ─── Stripe (not used yet) ─────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Social platforms (not used yet) ───────────────────────
# LinkedIn — create an app at https://www.linkedin.com/developers/apps and add the self-serve
# products "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn".
# Set all three to enable LinkedIn. Requires TOKEN_ENCRYPTION_KEY.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match a redirect URL on the app's Auth tab. In development the Vite proxy serves it:
#   http://localhost:5173/api/v1/social-accounts/linkedin/callback
# Production must use HTTPS, e.g. https://app.example.com/api/v1/social-accounts/linkedin/callback
LINKEDIN_REDIRECT_URI=
# LinkedIn-Version header (YYYYMM). Versions are supported for at least a year; update yearly.
LINKEDIN_API_VERSION=202608
# Meta app covers both Facebook and Instagram Graph APIs
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Google OAuth client for the YouTube Data API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Social integrations ───────────────────────────────────
# REQUIRED in production (and to connect accounts in development). Encrypts OAuth tokens at rest.
# 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Key rotation: move the old key here (comma-separated) when setting a new TOKEN_ENCRYPTION_KEY.
# Tokens are re-encrypted with the new key as they are used.
TOKEN_ENCRYPTION_PREVIOUS_KEYS=
# How long a "Connect account" link stays valid
SOCIAL_OAUTH_STATE_TTL_MINUTES=10
