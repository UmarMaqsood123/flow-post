# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Number of reverse-proxy hops to trust (0 locally, 1 behind a single load balancer)
TRUST_PROXY=0
JSON_BODY_LIMIT=1mb

# ─── CORS / Frontend ───────────────────────────────────────
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Used to build links in emails (verify email, reset password)
FRONTEND_URL=http://localhost:5173

# ─── Rate limiting (applies to /api/v1, excluding health checks) ─
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# memory (single instance) | redis (shared across instances — use in production)
RATE_LIMIT_STORE=memory

# ─── MongoDB ───────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/flowpost

# ─── Redis (cache, rate limiting, BullMQ) ───────────────────
REDIS_URL=redis://localhost:6379

# ─── Authentication ────────────────────────────────────────
# REQUIRED. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=flowpost-api
JWT_AUDIENCE=flowpost-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Seconds a just-rotated refresh token is still accepted (reload during refresh, parallel tabs). 0 = off
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
WORKSPACE_INVITATION_TTL_DAYS=7
# Leave empty for host-only cookies. Set (e.g. .flowpost.app) if API and app are on sibling subdomains.
COOKIE_DOMAIN=
# lax (same-site app + API) | strict | none (cross-site; requires NODE_ENV=production)
COOKIE_SAME_SITE=lax

# ─── Email ─────────────────────────────────────────────────
# console (log emails, dev) | memory (tests) | smtp (required in production)
EMAIL_PROVIDER=console
EMAIL_FROM="FlowPost <no-reply@flowpost.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── File storage (Oracle Cloud Object Storage, as in jobs-viewer) ─
# none (uploads disabled) | memory (tests only) | oci
STORAGE_PROVIDER=none
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
# e.g. ap-singapore-1
OCI_REGION=
OCI_NAMESPACE=
OCI_BUCKET=
# Provide the API signing key ONE way — never commit it:
#   OCI_PRIVATE_KEY_PATH=./secrets/oci_api_key.pem   (secrets/ and *.pem are gitignored)
#   OCI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
OCI_PRIVATE_KEY_PATH=
OCI_PRIVATE_KEY=
OCI_PRIVATE_KEY_PASSPHRASE=
# Optional: serve files from a CDN or custom domain instead of the bucket URL
STORAGE_PUBLIC_BASE_URL=
UPLOAD_MAX_FILE_SIZE_MB=10
# Videos can be larger; uploads stream through temporary files on disk, not memory
UPLOAD_MAX_VIDEO_SIZE_MB=100
UPLOAD_MAX_FILES=10

# ─── AI ────────────────────────────────────────────────────
# `openai` (paid), `openai-compatible` (free tiers and local models), or `none`.
AI_PROVIDER=openai

# --- Free option: any service speaking OpenAI's Chat Completions API ---
# Set AI_PROVIDER=openai-compatible and uncomment one recipe.
#
# Groq — free tier, fast, enforces JSON schemas on the GPT-OSS models:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_...
# AI_MODEL=openai/gpt-oss-120b
# AI_PROVIDER_LABEL=groq
#
# Google Gemini — free tier via the OpenAI compatibility endpoint:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=AIza...
# AI_MODEL=gemini-3.8-flash
# AI_PROVIDER_LABEL=gemini
#
# OpenRouter — free models (about 20 requests/minute, 200/day):
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...
# AI_MODEL=openrouter/free
# AI_PROVIDER_LABEL=openrouter
#
# Local models (Ollama, LM Studio) — no key, no limits, needs a capable machine:
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# AI_PROVIDER_LABEL=ollama
# AI_STRUCTURED_MODE=json_object
#
# json_schema (default) lets the service enforce the shape; json_object is the
# fallback for models that can't, and puts the schema in the prompt instead.
# AI_STRUCTURED_MODE=json_schema
OPENAI_API_KEY=
# Defaults to gpt-5.6-terra. Add new models to src/integrations/ai/pricing.ts for cost estimates.
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Per attempt. Timeouts, 429s and 5xx responses are retried with exponential backoff.
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
# Upper bound per request (a full content strategy needs about 12,000).
AI_MAX_OUTPUT_TOKENS=16000

# ─── Publishing worker (BullMQ over Redis) ─────────────────
# Run it with `npm run dev:worker`; it needs REDIS_URL and MONGO_URI.
PUBLISH_CONCURRENCY=5
# Attempts per scheduled post, including the first.
PUBLISH_MAX_ATTEMPTS=3
# First retry delay; it doubles on each further attempt.
PUBLISH_BACKOFF_MS=60000
# A job claimed longer ago than this is treated as left behind by a crashed worker.
PUBLISH_LOCK_TIMEOUT_MS=300000
# How often the worker sweeps for abandoned jobs and missing queue entries.
PUBLISH_RECOVERY_INTERVAL_MS=60000

# ─── Stripe (not used yet) ─────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Social platforms (not used yet) ───────────────────────
# LinkedIn — create an app at https://www.linkedin.com/developers/apps and add the self-serve
# products "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn".
# Set all three to enable LinkedIn. Requires TOKEN_ENCRYPTION_KEY.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match a redirect URL on the app's Auth tab. In development the Vite proxy serves it:
#   http://localhost:5173/api/v1/social-accounts/linkedin/callback
# Production must use HTTPS, e.g. https://app.example.com/api/v1/social-accounts/linkedin/callback
# The Company Pages app below uses the same callback, so register it on both apps.
LINKEDIN_REDIRECT_URI=
# LinkedIn Company Pages. Create a SECOND app (LinkedIn only offers the Community
# Management API to an app with no other products), request Community Management
# API access for it, and put its credentials here. Scopes used: rw_organization_admin,
# w_organization_social. Leave empty to offer personal profiles only.
LINKEDIN_PAGES_CLIENT_ID=
LINKEDIN_PAGES_CLIENT_SECRET=
# LinkedIn-Version header (YYYYMM). Versions are supported for at least a year; update yearly.
LINKEDIN_API_VERSION=202608
# ─── Meta (Facebook Pages + Instagram) ───
# One Business-type app with Facebook Login for Business covers both. Publishing
# needs Advanced Access via App Review (pages_show_list, pages_read_engagement,
# pages_manage_posts, instagram_basic, instagram_content_publish), Business
# Verification, and Tech Provider Access Verification. Until then it only works
# for people with a role on the app.
META_APP_ID=
META_APP_SECRET=
# Each platform has its own callback path, so register both on the Meta app.
# Production must use HTTPS.
META_FACEBOOK_REDIRECT_URI=
# Instagram uses this one callback for both Instagram Login and Facebook Login,
# so register it under Facebook Login settings and under Instagram > API setup
# with Instagram login > Business login settings.
META_INSTAGRAM_REDIRECT_URI=
# Instagram Login: connect an Instagram professional account directly, with no
# Facebook Page. Add the Instagram product to the Meta app and copy the
# "Instagram app ID" and "Instagram app secret" from API setup with Instagram
# login (they are NOT META_APP_ID/META_APP_SECRET). Needs Advanced Access to
# instagram_business_basic, instagram_business_content_publish and
# instagram_business_manage_insights. Instagram works with either login or both.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Graph API version. v26.0 was released July 2026; versions are supported ~2 years.
META_GRAPH_VERSION=v26.0
# ─── TikTok ───
# Content Posting API. `video.publish` needs app review before direct posting
# works; until the app is audited every post is forced to private (SELF_ONLY).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok rejects redirect URIs containing a query string, and requires HTTPS.
TIKTOK_REDIRECT_URI=
# ─── YouTube ───
# Google OAuth client for the YouTube Data API v3. Uploads from an unaudited
# API project are locked private, and the app is capped at 100 users until
# Google OAuth verification passes. Default quota is 100 uploads per day.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ─── Social integrations ───────────────────────────────────
# REQUIRED in production (and to connect accounts in development). Encrypts OAuth tokens at rest.
# 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Key rotation: move the old key here (comma-separated) when setting a new TOKEN_ENCRYPTION_KEY.
# Tokens are re-encrypted with the new key as they are used.
TOKEN_ENCRYPTION_PREVIOUS_KEYS=
# How long a "Connect account" link stays valid
SOCIAL_OAUTH_STATE_TTL_MINUTES=10
# How often the worker renews tokens that lapse unless refreshed (Instagram Login lasts 60 days).
SOCIAL_TOKEN_REFRESH_INTERVAL_MS=21600000
# Stripe price ids per plan (monthly required when billing is on; yearly optional)
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=
# Days a past-due subscription keeps its plan while Stripe retries payment
BILLING_GRACE_DAYS=7
# Plan for accounts without a paid subscription (FREE in production)
BILLING_DEFAULT_PLAN=FREE
BILLING_SYNC_INTERVAL_MS=21600000
