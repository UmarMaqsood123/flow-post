# ─── Exposed to the browser (VITE_* only — never put secrets here) ───
VITE_APP_NAME=FlowPost
# Relative path uses the Vite dev proxy locally.
# In production set the full API URL, e.g. https://api.flowpost.app/api/v1
VITE_API_BASE_URL=/api/v1
# Shown on the Contact, Terms and Privacy pages.
VITE_SUPPORT_EMAIL=support@flowpost.app

# ─── Dev server only (read in vite.config.ts, not bundled) ───
DEV_SERVER_PORT=5173
DEV_API_PROXY_TARGET=http://localhost:5000
